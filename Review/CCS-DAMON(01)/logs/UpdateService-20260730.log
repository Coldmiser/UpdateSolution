                ErrorMessage   = if ($succeeded -or $resultCode -eq 0) { '' } else { 'ResultCode=' + $resultCode }
                RebootRequired = $needsReboot
                AttemptedAt    = (Get-Date -Format 'o')
            }
        }

        $results = @($byKey.Values)

        if ($results.Count -eq 0) {
            Write-Output '[]'
        } else {
            $results | ConvertTo-Json -Compress
        }
