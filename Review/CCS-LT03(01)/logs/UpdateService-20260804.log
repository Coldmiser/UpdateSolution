            if (-not ($u.PSObject.Properties.Name -contains 'Title')) { continue }
            if ([string]::IsNullOrWhiteSpace($u.Title)) { continue }

            $resultCode = 0
            try { $resultCode = [int]$u.ResultCode } catch { $resultCode = 4 }
            $succeeded = ($resultCode -eq 2 -or $resultCode -eq 3)

