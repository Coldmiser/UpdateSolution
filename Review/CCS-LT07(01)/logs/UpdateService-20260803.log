        # objects -- we filter them out in the foreach loop below.
        $rawOutput = Install-WindowsUpdate `
            -MicrosoftUpdate `
            -AcceptAll `
            -IgnoreReboot `
            -Install `
            -ErrorAction Continue 2>&1

