<!-- UpdateNotifier/Views/CountdownWindow.xaml
     Short warning shown 5 minutes before a scheduled reboot.
     Design goals:
       • Small, always on top.
       • Live countdown to the reboot time.
       • ONE action: "Delay 5 Minutes". Closing the window (or doing nothing)
         lets the reboot proceed — no interaction is required.
       • Closes itself automatically when the countdown reaches zero.
-->
<Window x:Class="UpdateNotifier.Views.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Reboot Imminent"
        Width="440" Height="Auto" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <!-- Brand colours (same palette as MainWindow) -->
        <Color x:Key="BrandBlue">#1E4D8C</Color>
        <Color x:Key="BrandDark">#0D1B2A</Color>
        <Color x:Key="BrandLight">#F0F4FA</Color>
        <SolidColorBrush x:Key="BrandBlueBrush"  Color="{StaticResource BrandBlue}"  />
        <SolidColorBrush x:Key="BrandDarkBrush"  Color="{StaticResource BrandDark}"  />
        <SolidColorBrush x:Key="BrandLightBrush" Color="{StaticResource BrandLight}" />

        <!-- Button style (same as MainWindow's PrimaryButton) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"   Value="{StaticResource BrandBlueBrush}" />
            <Setter Property="Foreground"   Value="White" />
            <Setter Property="FontSize"     Value="14" />
            <Setter Property="FontWeight"   Value="SemiBold" />
            <Setter Property="Padding"      Value="24,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor"       Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A6DD9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#163A6B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BrandLightBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Header ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource BrandBlueBrush}"
                Padding="20,12">
            <TextBlock Text="Capital Technology Group System Update"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Bold" />
        </Border>

        <!-- ═══ Body ════════════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="1" Margin="28,20,28,12">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="⚠" FontSize="28" Foreground="#D97706"
                           VerticalAlignment="Top" Margin="0,2,10,0" />
                <TextBlock TextWrapping="Wrap"
                           FontSize="14"
                           Foreground="{StaticResource BrandDarkBrush}">
                    <Run FontWeight="SemiBold"
                         Text="This PC is about to reboot." />
                    <LineBreak />
                    <Run x:Name="RebootTimeRun"
                         Text="Your computer will restart to complete updates." />
                </TextBlock>
            </StackPanel>

            <!-- Live countdown -->
            <TextBlock x:Name="CountdownText"
                       Text="5:00"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="{StaticResource BrandBlueBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,8" />

            <TextBlock FontSize="12" Foreground="#9CA3AF"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       Text="If you do nothing, the reboot will proceed automatically." />
        </StackPanel>

        <!-- ═══ Action strip ════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0"
                Padding="28,14">
            <Button HorizontalAlignment="Center"
                    Content="Delay 5 Minutes"
                    Style="{StaticResource PrimaryButton}"
                    Click="DelayButton_Click" />
        </Border>
    </Grid>
</Window>
